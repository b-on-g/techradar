$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$mol_page $mol_view
	dom_name \article
	attr *
		^
		tabIndex <= tabindex -1
	sub /
		<= Head $mol_view
			minimal_height 64
			dom_name \header
			sub <= head /
				<= Title $mol_view
					dom_name \h1
					sub <= title_content /
						<= Logo null
						<= title
				<= Tools $mol_view
					sub <= tools /$mol_view_content
		<= Body $mol_scroll
			scroll_top? => body_scroll_top?
			sub <= body_content /
				<= Body_content $mol_view
					sub <= body /$mol_view
		<= Foot $mol_view
			dom_name \footer
			sub <= foot /$mol_view

$bog_theme_auto $mol_plugin
	themes <= themes_default /
	theme_light \$mol_theme_light
	theme_dark \$mol_theme_dark
	mode? \system
	mode_next? null
	theme_next? null
	theme_prev? null
	theme_set? null
	is_light_now false
	attr * mol_theme <= theme \

$mol_ghost $mol_view
	Sub $mol_view

$mol_follower $mol_ghost
	Anchor $mol_view
	align /number
		-.5
		-.5
	offset /number
		0
		0
	style *
		^
		transform <= transform \

$mol_pop $mol_view
	showed? false
	align_vert \
	align_hor \
	align \bottom_center
	prefer \vert
	auto /
		<= bubble null
	sub /
		<= Anchor null
	sub_visible /
		<= Anchor
		<= Follower $mol_follower
			offset <= bubble_offset /number
				0
				1
			align <= bubble_align /number
				0
				0
			Anchor <= Anchor
			Sub <= Bubble $mol_pop_bubble
				content <= bubble_content /$mol_view_content
				height_max <= height_max 9999

$mol_pop_bubble $mol_view
	sub <= content /$mol_view_content
	style *
		^
		maxHeight <= height_max 9999
	attr *
		^
		tabindex 0
		popover \manual

$mol_hotkey $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null

$mol_list $mol_view
	render_visible_only true
	render_over 0.1
	sub <= rows /$mol_view
		<= Gap_before $mol_view style * paddingTop <= gap_before 0
		<= Empty $mol_view
		<= Gap_after $mol_view style * paddingTop <= gap_after 0
	item_height_min* 1
	item_width_min* 1
	view_window_shift? 0
	view_window /
		0
		0

$mol_speck $mol_view
	theme \$mol_theme_accent
	sub /
		<= value null

$mol_button $mol_view
	enabled true
	click? null
	event_click? null
	status? /
	event *
		^
		click? <=> activate? <=> event_activate? null
		dblclick? <=> clicks? null
		keydown? <=> key_press? <=> event_key_press? null
	attr *
		^
		disabled <= disabled false
		role \button
		tabindex <= tab_index 0
		title <= hint_safe <= hint \
	sub /$mol_view_content
		<= title
	Speck $mol_speck
		value <= error \

$mol_button_typed $mol_button
	minimal_height 40
	minimal_width 40

$mol_button_minor $mol_button_typed

$bog_theme_picker_row $mol_button_minor
	theme_name \
	title <= theme_name
	attr *
		^
		bog_theme_picker_row_focused <= focused_str \
	event *
		^
		pointerenter?event <=> hover?event null

$bog_theme_picker $mol_scroll
	theme_auto $bog_theme_auto
	close? null
	query?val \
	focused_index?val -1
	Theme_row* $bog_theme_picker_row
		theme_name <= theme_name* \
		focused <= theme_focused* false
		click?event <=> theme_select*?event null
		hover?event <=> theme_hover*?event null
	sub /
		<= Content $mol_list rows /
			<= Search $mol_string
				value?val <=> query?val
				hint @ \Just start typing
			<= Theme_list $mol_list
				rows <= theme_rows /
	event *
		^
		keydown?event <=> key_down?event null

$mol_svg $mol_view
	dom_name \svg
	dom_name_space \http://www.w3.org/2000/svg
	font_size 16
	font_family \
	style_size *

$mol_svg_root $mol_svg
	dom_name \svg
	attr *
		^
		viewBox <= view_box \0 0 100 100
		preserveAspectRatio <= aspect \xMidYMid

$mol_svg_path $mol_svg
	dom_name \path
	attr *
		^
		d <= geometry \


$mol_icon $mol_svg_root
	view_box \0 0 24 24
	minimal_width 16
	minimal_height 16
	sub /
		<= Path $mol_svg_path
			geometry <= path \

$mol_icon_white_balance_sunny $mol_icon path \M3.55 19.09L4.96 20.5L6.76 18.71L5.34 17.29M12 6C8.69 6 6 8.69 6 12S8.69 18 12 18 18 15.31 18 12C18 8.68 15.31 6 12 6M20 13H23V11H20M17.24 18.71L19.04 20.5L20.45 19.09L18.66 17.29M20.45 5L19.04 3.6L17.24 5.39L18.66 6.81M13 1H11V4H13M6.76 5.39L4.96 3.6L3.55 5L5.34 6.81L6.76 5.39M1 13H4V11H1M13 20H11V23H13

$mol_icon_weather_night $mol_icon path \M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95M17.33,17.97C14.5,17.81 11.7,16.64 9.53,14.5C7.36,12.31 6.2,9.5 6.04,6.68C3.23,9.82 3.34,14.64 6.35,17.66C9.37,20.67 14.19,20.78 17.33,17.97Z

$mol_icon_monitor $mol_icon path \M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z

$bog_theme_toggle $mol_pop
	theme_auto $bog_theme_auto
	showed?val false
	align \bottom_right
	Anchor $mol_button_minor
		sub /
			<= Icon $mol_view
		hint <= anchor_hint \Переключить тему
		click?event <=> clicked?event null
		event *
			^
			pointerdown?event <=> press_start?event null
			pointermove?event <=> press_move?event null
			pointerup?event <=> press_end?event null
			pointercancel?event <=> press_cancel?event null
			lostpointercapture?event <=> press_lost?event null
	Icon_light $mol_icon_white_balance_sunny
	Icon_dark $mol_icon_weather_night
	Icon_system $mol_icon_monitor
	bubble_content /
		<= Backdrop $mol_view
			event *
				click?event <=> backdrop_click?event null
		<= Picker $bog_theme_picker
			theme_auto <= theme_auto
			close? <=> picker_close? null

$mol_svg_text $mol_svg
	dom_name \text
	pos /
	attr *
		^
		x <= pos_x \
		y <= pos_y \
		text-anchor <= align_hor <= align \middle
		alignment-baseline <= align_vert \baseline
	sub /
		<= text \

$mol_svg_circle $mol_svg
	dom_name \circle
	pos /
	attr *
		^
		r <= radius \.5%
		cx <= pos_x \
		cy <= pos_y \

$mol_svg_line $mol_svg
	dom_name \line
	pos /
		<= from /
		<= to /
	attr *
		^
		x1 <= from_x \
		y1 <= from_y \
		x2 <= to_x \
		y2 <= to_y \

$mol_svg_group $mol_svg
	dom_name \g

$mol_pop_over $mol_pop
	showed <= hovered? false
	attr *
		^
		tabindex 0
	event *
		^
		mouseenter? <=> event_show? null
		mouseleave? <=> event_hide? null

$mol_link $mol_view
	uri \
	dom_name \a
	uri_off \
	uri_native null
	external false
	attr *
		^
		href <= uri_unsafe <= uri_toggle \
		title <= hint_safe <= hint \
		target <= target \_self
		download <= file_name \
		mol_link_current <= current false
		rel <= relation \
	sub /$mol_view_content
		<= title
	arg *
	event *
		^
		click? <=> click? <=> event_click? null

$bog_techradar_app $mol_page
	title \Tech Radar — $mol Stack
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	tools /
		<= Lights $bog_theme_toggle
			theme_auto <= Theme
	body /
		<= Header $mol_view
			sub /
				<= Header_title $mol_view sub /
					\Tech Radar — $mol Stack
				<= Header_date $mol_view sub /
					<= header_date_text \2026.06
		<= Info $mol_view
			sub /
				<= Info_intro $mol_view sub /
					\От центра к периферии радара идут четыре круга:
				<= Info_adopt $mol_view sub /
					\Adopt — технологии и инструменты, которые внедрены и активно используются в командах. Технологии, по которым в X5Tech есть экспертиза.
				<= Info_trial $mol_view sub /
					\Trial — технологии и инструменты, которые уже прошли этап тестирования и готовятся к работе в продакшн (или уже работают там).
				<= Info_assess $mol_view sub /
					\Assess — пробные технологии и инструменты, которые сейчас оцениваются. С их участием реализуются только тестовые проекты, в реальных задачах они не используются.
				<= Info_hold $mol_view sub /
					\Hold — в этой категории есть экспертиза, но инструменты используются только при поддержке существующих систем — новые проекты на них не запускаются.
				<= Info_source $mol_view sub /
					\За основу взят Tech Radar Zalando. Похожие есть у ThoughtWorks. В России концепцию используют, например, Avito и Lamoda.
		<= Layout $mol_view
			sub /
				<= Q_block_techniques $mol_view
					sub /
						<= Q_block_techniques_title $mol_view sub /
							\Techniques
						<= Q_block_techniques_list $mol_view sub <= q_block_techniques_items /
				<= Q_block_tools $mol_view
					sub /
						<= Q_block_tools_title $mol_view sub /
							\Tools & Environment
						<= Q_block_tools_list $mol_view sub <= q_block_tools_items /
				<= Q_block_libraries $mol_view
					sub /
						<= Q_block_libraries_title $mol_view sub /
							\Libraries
						<= Q_block_libraries_list $mol_view sub <= q_block_libraries_items /
				<= Q_block_languages $mol_view
					sub /
						<= Q_block_languages_title $mol_view sub /
							\Languages & Frameworks
						<= Q_block_languages_list $mol_view sub <= q_block_languages_items /
				<= Radar_box $mol_view
					sub /
						<= Radar $mol_svg_root
							view_box \-700 -500 1400 1000
							event *
								^
								mouseleave? <=> radar_leave?event null
							sub <= radar_items /
						<= Pops $mol_view
							sub <= blip_pops /
		<= Forms_legend $mol_view
			sub /
				\▲ moved up    ▼ moved down    ★ new    ⬤ no change
	Ring* $mol_svg_circle
		pos_x \0
		pos_y \0
		radius <= ring_radius* \0
		attr *
			^
			fill \none
			stroke \#bbb
			stroke-width \1
	Axis* $mol_svg_line
		from_x <= axis_from_x* \0
		from_y <= axis_from_y* \0
		to_x <= axis_to_x* \0
		to_y <= axis_to_y* \0
		attr *
			^
			stroke \#bbb
			stroke-width \1
	R_big_label* $mol_svg_text
		pos_x \0
		pos_y <= r_big_label_y* \0
		text <= r_big_label_text* \
		attr *
			^
			fill <= r_big_label_color* \#5ba300
			font-size \42
			font-weight \bold
			text-anchor \middle
			opacity <= r_big_label_opacity* \0.25
	Blip* $mol_svg_group
		sub /
			<= Blip_shape* $mol_svg_path
				geometry <= blip_shape_d* \
				attr *
					^
					fill <= blip_color* \#5ba300
			<= Blip_num* $mol_svg_text
				pos_x <= blip_x* \0
				pos_y <= blip_num_y* \0
				text <= blip_num* \
				attr *
					^
					fill \#fff
					font-size \11
					font-weight \bold
					text-anchor \middle
					pointer-events \none
	Blip_pop* $mol_pop_over
		align \top_center
		event *
			^
			click? <=> blip_pop_click*?event null
		bubble_content /
			<= blip_label* \
	R_header* $mol_view
		sub /
			<= r_header_text* \
	Blip_row* $mol_link
		uri <= blip_row_uri* \
		external true
		title <= blip_row_text* \
	Blip_text* $mol_view
		sub /
			<= blip_row_text* \
